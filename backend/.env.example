# Copy to .env and fill in real values. Never commit .env.
# --- Database (PostgreSQL is the primary database) ---
DATABASE_URL=postgresql+psycopg://researchos:researchos@localhost:5432/researchos
# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated admin emails (auto-promoted on register + login).
# ADMIN_EMAILS=you@example.edu
# --- Frontend origin allowed by CORS (exact origin, no trailing slash) ---
FRONTEND_ORIGIN=http://localhost:3002
# --- Server ---
ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# --- Uploads ---
UPLOAD_DIRECTORY=storage
MAX_UPLOAD_SIZE_MB=15
# --- Session cookie (HttpOnly JWT). COOKIE_SECURE=true in production (HTTPS). ---
SESSION_COOKIE_NAME=ros_session
SESSION_EXPIRE_DAYS=7
# COOKIE_SECURE=
# --- Rate limiting ---
AUTH_RATE_LIMIT=10/minute
RAG_RATE_LIMIT=30/minute
# --- RAG / AI ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-simhash-v1
LLM_PROVIDER=local
LLM_MODEL=local-extractive-v1
# OPENAI_API_KEY=  # Required when using openai provider
# OPENAI_BASE_URL=https://api.openai.com/v1
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
RAG_MAX_QUESTION_CHARS=2000
RAG_MAX_CONTEXT_CHARS=6000
RAG_REQUEST_TIMEOUT=60
RAG_TRACK_USAGE=true
# --- Phase 3: Activity / audit logs are always enabled ---
# No additional env vars required for knowledge graph, collections,
# activity logs, or audit logs. They use the existing DATABASE_URL.
